{
  "name": "@patchrace/tasks",
  "version": "0.1.0",
  "description": "PatchRace task and grader foundations",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juanjuan-mm/PatchRace.git",
    "directory": "packages/tasks"
  },
  "homepage": "https://github.com/Juanjuan-mm/PatchRace#readme",
  "bugs": {
    "url": "https://github.com/Juanjuan-mm/PatchRace/issues"
  },
