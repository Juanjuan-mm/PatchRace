{
  "name": "patchrace",
  "version": "0.1.0",
  "description": "Race coding agents, distill what wins, and make Pi better",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Juanjuan-mm/PatchRace.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Juanjuan-mm/PatchRace#readme",
  "bugs": {
    "url": "https://github.com/Juanjuan-mm/PatchRace/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <27"
  },
  "bin": {
    "patchrace": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/.tsbuildinfo",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@patchrace/adapters": "workspace:^",
    "@patchrace/contracts": "workspace:^",
    "@patchrace/core": "workspace:^",
    "@patchrace/diagnosis": "workspace:^",
    "@patchrace/optimizer": "workspace:^",
    "@patchrace/report": "workspace:^",
    "@patchrace/tasks": "workspace:^",
    "commander": "15.0.0"
  }
}
